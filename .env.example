# ==========================================
# JobTrack Full-Stack Environment Variables
# ==========================================

# --- Django Backend (backend/.env) ---
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yourdomain.com

# Database (Leave unset for SQLite, or provide PostgreSQL connection string for production)
# DATABASE_URL=postgresql://jobtrack_user:securepassword@db.provider.com:5432/jobtrack_db

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- React + Vite Frontend (frontend/.env) ---
VITE_API_URL=http://127.0.0.1:8000
